# Copie para .env.local e preencha. Nunca commite o .env.local.

# Neon (Console → Auth e Console → Data API). São públicos: na Vercel, variáveis comuns.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxxx.apirest.sa-east-1.aws.neon.tech/neondb/rest/v1

# Só para `yarn db:migrate` no seu computador: connection string DIRETA (sem "-pooler").
DATABASE_URL=

# Upload de fotos no painel (a Vercel cria sozinha ao conectar um Blob Store público).
# Para testar upload local, copie da Vercel: `npx vercel@65 env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Opcionais
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_INDEXABLE=true
